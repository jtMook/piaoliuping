page{background-color:#0a1628;color:#fff;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif;font-size:28rpx;line-height:1.5}view,text{box-sizing:border-box}.container{padding:24rpx;min-height:100vh;box-sizing:border-box}.card{background:#162236;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;border:1px solid #1e3050}.btn{display:inline-flex;align-items:center;justify-content:center;padding:16rpx 32rpx;border-radius:16rpx;font-size:28rpx;font-weight:500;transition:all .15s ease;border:none}.btn-primary{background:#d4a843;color:#0a1628}.btn-primary:active{background:#c49a38}.btn-secondary{background:#1a2a42;color:#fff;border:1px solid #1e3050}.btn-secondary:active{background:#1e2d45}.btn-ghost{background:transparent;color:#89a}.btn-ghost:active{background:rgba(255,255,255,.1)}.btn-block{width:100%}.btn-lg{padding:24rpx 48rpx;font-size:32rpx}.btn-sm{padding:8rpx 24rpx;font-size:24rpx}.input{width:100%;padding:24rpx;background:#1a2a42;border:1px solid #1e3050;border-radius:16rpx;color:#fff;font-size:28rpx}.input:focus{border-color:#d4a843;outline:none}.input-textarea{min-height:200rpx;resize:none}.text-primary{color:#fff}.text-secondary{color:#89a}.text-muted{color:#5a6a7a}.text-success{color:#48bb78}.text-warning{color:#ed8936}.text-error{color:#fc8181}.text-info{color:#63b3ed}.flex{display:flex}.flex-col{flex-direction:column}.items-center{align-items:center}.justify-center{justify-content:center}.justify-between{justify-content:space-between}.flex-1{flex:1}.flex-wrap{flex-wrap:wrap}.gap-sm{gap:16rpx}.gap-md{gap:24rpx}.mt-sm{margin-top:16rpx}.mt-md{margin-top:24rpx}.mt-lg{margin-top:32rpx}.mb-sm{margin-bottom:16rpx}.mb-md{margin-bottom:24rpx}.mb-lg{margin-bottom:32rpx}@keyframes float{0%,to{transform:translateY(0)}50%{transform:translateY(-10rpx)}}@keyframes wave{0%{transform:translate(-100%)}to{transform:translate(100%)}}@keyframes ripple{0%{transform:scale(.8);opacity:1}to{transform:scale(2);opacity:0}}.animate-float{animation:float 3s ease-in-out infinite}.animate-wave{animation:wave 8s linear infinite}.animate-ripple{animation:ripple 1.5s ease-out infinite}
